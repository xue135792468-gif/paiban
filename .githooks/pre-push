#!/usr/bin/env bash
# Refuse to push a branch that does not contain the current origin/main.
# Verifying or merging a stale base silently skips integration with main.
# Bypass with `git push --no-verify` when the divergence is intentional.
set -euo pipefail
cd "$(dirname "$0")/.."

git fetch --quiet origin main || exit 0
if ! git merge-base --is-ancestor origin/main HEAD; then
  echo "pre-push: 当前分支不包含 origin/main，先合并 main 再推送。" >&2
  echo "          git fetch origin main && git merge origin/main" >&2
  exit 1
fi
