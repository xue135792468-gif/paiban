# Copy this file to .env and replace every value before a production deploy.
# Generate secrets with: openssl rand -hex 32
# .env is gitignored; never commit real secrets.

PAIBAN_JWT_SECRET=replace-with-at-least-32-random-characters
PAIBAN_AI_ENCRYPTION_KEY=replace-with-a-long-random-string
PAIBAN_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

POSTGRES_DB=paiban
POSTGRES_USER=paiban
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Comma-separated origins allowed to call the API cross-origin.
# A same-origin deployment behind the bundled nginx does not need this.
PAIBAN_CORS_ALLOWED_ORIGINS=https://paiban.example.com

TZ=Asia/Shanghai
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
