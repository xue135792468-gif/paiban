# Copy this file to .env. Placeholders are auto-replaced for local/test use by
# start.sh / start.bat (they generate real secrets); every placeholder MUST be
# replaced with a real value for a production deploy.
# Generate secrets with: openssl rand -hex 32
# .env is gitignored; never commit real secrets.

PAIBAN_JWT_SECRET=replace-with-at-least-32-random-characters
PAIBAN_AI_ENCRYPTION_KEY=replace-with-a-long-random-string
PAIBAN_SECURITY_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password

POSTGRES_DB=paiban
POSTGRES_USER=paiban
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Comma-separated origins allowed to call the API cross-origin.
# This is the development default (Vite dev server).
# A same-origin deployment behind the bundled nginx needs none.
# Set your domain here for a cross-origin deployment.
PAIBAN_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

TZ=Asia/Shanghai
JAVA_OPTS=-XX:MaxRAMPercentage=75.0
